# Secrets — NEVER commit
.env
*.env.*

# Session cookies (full account access)
*-cookies.json
cookies/

# Bluesky app passwords (account access)
bluesky-accounts.json

# Browser profiles (session data, passwords)
chrome-profile/
chrome-profiles/

# Persona identities
personas.json

# Runtime data
node_modules/
logs/
reports/
memory/
debug/
.next/

# State files (regenerated at runtime)
outreach-monitor-state.json
outreach-community-posts.json
outreach-tracker.json
# Campanas de feedback manual: contienen emails reales de usuarios. Mismo motivo
# que ya se aplico en el repo publico de la webapp (linea propia en su .gitignore).
feedback-campaign-*.json

# Lock files (regenerable)
package-lock.json

# Binaries
node/
cloudflared.exe

# Claude Code local config
.claude/

# Persona scaffold dirs
persona-alex/
persona-ferran/

# Windows/system
*.ico
*.lnk
Thumbs.db
Desktop.ini
node
