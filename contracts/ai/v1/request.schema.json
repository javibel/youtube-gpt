{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:ytubviral:ai:v1:request",
  "type": "object",
  "properties": {
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "taskType": {
      "type": "string",
      "minLength": 1
    },
    "contractVersion": {
      "const": "1.0"
    },
    "inputVersion": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "instructions": {
      "type": "string"
    },
    "instructionsVersion": {
      "type": "string",
      "minLength": 1
    },
    "requiredCapabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "budget": {
      "type": "object",
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "maxCostMicros": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "deadlineMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      },
      "required": [
        "currency",
        "maxCostMicros",
        "maxOutputTokens",
        "deadlineMs"
      ],
      "additionalProperties": false
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "enum": [
              "user",
              "assistant",
              "system",
              "tool"
            ]
          },
          "content": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "const": "text"
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "text"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "const": "image"
                    },
                    "url": {
                      "type": "string",
                      "pattern": "^https://"
                    },
                    "mediaType": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "type",
                    "url",
                    "mediaType"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": [
          "role",
          "content"
        ],
        "additionalProperties": false
      }
    },
    "outputSchema": {
      "$ref": "urn:ytubviral:ai:v1:output-schema"
    },
    "toolPolicy": {
      "type": "object",
      "properties": {
        "allowed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "maxCalls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "allowed",
        "maxCalls"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "requestId",
    "taskType",
    "contractVersion",
    "inputVersion",
    "language",
    "instructions",
    "instructionsVersion",
    "requiredCapabilities",
    "budget",
    "messages",
    "toolPolicy"
  ],
  "additionalProperties": false
}
