{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:ytubviral:ai:v1:coding-request",
  "type": "object",
  "properties": {
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "taskType": {
      "type": "string",
      "minLength": 1
    },
    "contractVersion": {
      "const": "1.0"
    },
    "inputVersion": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "instructions": {
      "type": "string"
    },
    "instructionsVersion": {
      "type": "string",
      "minLength": 1
    },
    "requiredCapabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "budget": {
      "type": "object",
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "maxCostMicros": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "deadlineMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      },
      "required": [
        "currency",
        "maxCostMicros",
        "maxOutputTokens",
        "deadlineMs"
      ],
      "additionalProperties": false
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "repositoryId": {
      "type": "string",
      "minLength": 1
    },
    "baseRevision": {
      "type": "string",
      "minLength": 1
    },
    "allowedFiles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "permissions": {
      "type": "object",
      "properties": {
        "read": {
          "type": "boolean"
        },
        "edit": {
          "type": "boolean"
        },
        "execute": {
          "type": "boolean"
        },
        "commit": {
          "type": "boolean"
        },
        "deploy": {
          "const": false
        },
        "communicate": {
          "const": false
        }
      },
      "required": [
        "read",
        "edit",
        "execute",
        "commit",
        "deploy",
        "communicate"
      ],
      "additionalProperties": false
    },
    "allowedCommands": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        }
      }
    },
    "checkpoint": {
      "type": "object",
      "properties": {
        "objective": {
          "type": "string"
        },
        "progress": {
          "type": "string"
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pending": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "objective",
        "progress",
        "changes",
        "tests",
        "pending"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "requestId",
    "taskType",
    "contractVersion",
    "inputVersion",
    "language",
    "instructions",
    "instructionsVersion",
    "requiredCapabilities",
    "budget",
    "objective",
    "repositoryId",
    "baseRevision",
    "allowedFiles",
    "permissions",
    "allowedCommands"
  ],
  "additionalProperties": false
}
