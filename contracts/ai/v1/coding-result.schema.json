{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:ytubviral:ai:v1:coding-result",
  "type": "object",
  "properties": {
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "contractVersion": {
      "const": "1.0"
    },
    "providerId": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "adapterVersion": {
      "type": "string",
      "minLength": 1
    },
    "configRevision": {
      "type": "string",
      "minLength": 1
    },
    "instructionsVersion": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "completed",
        "incomplete",
        "refused",
        "failed",
        "cancelled"
      ]
    },
    "text": {
      "type": [
        "string",
        "null"
      ]
    },
    "data": {},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^https?://"
          },
          "title": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "url",
          "title"
        ],
        "additionalProperties": false
      }
    },
    "usage": {
      "type": "object",
      "properties": {
        "inputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "outputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cacheReadTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cacheWriteTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "toolCalls": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "costMicros": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "priceVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "estimated": {
          "type": "boolean"
        }
      },
      "required": [
        "inputTokens",
        "outputTokens",
        "cacheReadTokens",
        "cacheWriteTokens",
        "toolCalls",
        "costMicros",
        "currency",
        "priceVersion",
        "estimated"
      ],
      "additionalProperties": false
    },
    "error": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "enum": [
                "credentials",
                "permissions",
                "quota",
                "rate_limit",
                "deadline",
                "transport",
                "capability",
                "invalid_format",
                "uncertain",
                "configuration",
                "cancelled"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "additionalProperties": false
        }
      ]
    },
    "checkpoint": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "objective": {
              "type": "string"
            },
            "progress": {
              "type": "string"
            },
            "changes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "tests": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "pending": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "objective",
            "progress",
            "changes",
            "tests",
            "pending"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "requestId",
    "runId",
    "contractVersion",
    "providerId",
    "model",
    "adapterVersion",
    "configRevision",
    "instructionsVersion",
    "status",
    "text",
    "data",
    "sources",
    "usage",
    "error",
    "checkpoint"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "changes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "create",
                        "modify",
                        "delete"
                      ]
                    },
                    "patch": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "path",
                    "kind",
                    "patch"
                  ],
                  "additionalProperties": false
                }
              },
              "commands": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "argv": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "minItems": 1
                    },
                    "exitCode": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "argv",
                    "exitCode"
                  ],
                  "additionalProperties": false
                }
              },
              "answer": {
                "type": "string"
              },
              "validations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "passed": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "name",
                    "passed"
                  ],
                  "additionalProperties": false
                }
              },
              "pending": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "changes",
              "commands",
              "validations",
              "pending"
            ],
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
