{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:ytubviral:ai:v1:configuration",
  "type": "object",
  "properties": {
    "contractVersion": {
      "const": "1.0"
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "fallback": {
      "const": "none"
    },
    "activeProfile": {
      "type": "string",
      "minLength": 1
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {
          "type": "object",
          "properties": {
            "providerId": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "providerId",
            "model"
          ],
          "additionalProperties": false
        }
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scope": {
            "enum": [
              "task",
              "agent"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "selection": {
            "type": "object",
            "properties": {
              "providerId": {
                "type": "string",
                "minLength": 1
              },
              "model": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "providerId",
              "model"
            ],
            "additionalProperties": false
          },
          "authorizedBy": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "scope",
          "id",
          "selection",
          "authorizedBy",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "contractVersion",
    "revision",
    "fallback",
    "activeProfile",
    "profiles",
    "exceptions"
  ],
  "additionalProperties": false
}
