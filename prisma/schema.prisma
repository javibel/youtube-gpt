generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  feedbackEmailSentAt DateTime?
  onboardingStep      Int       @default(0)

  accounts        Account[]
  sessions        Session[]
  generations     Generation[]
  subscription    Subscription?
  review          Review?
  youtubeToken    YoutubeToken?
  videoPreviews   VideoPreview[]
  videoSeoScores    VideoSeoScore[]
  bestTimeAnalysis  BestTimeAnalysis?
  channelSnapshots  ChannelSnapshot[]
  dailyIdeas           DailyIdea[]
  trackedCompetitors   TrackedCompetitor[]
  extensionTokens      ExtensionToken[]
  calendarEntries      CalendarEntry[]
  feedback        UserFeedback?

  @@map("users")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id        String   @id @default(cuid())
  sessionToken String  @unique
  userId    String
  expires   DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@map("email_verification_tokens")
}

model Generation {
  id          String    @id @default(cuid())
  userId      String
  template    String
  inputs      Json
  output      String
  tokensUsed  Int
  ipAddress   String?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([ipAddress, createdAt])
  @@map("generations")
}

model Review {
  id        String   @id @default(cuid())
  userId    String   @unique
  rating    Int
  text      String
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model Subscription {
  id              String    @id @default(cuid())
  userId          String    @unique
  stripeCustomerId String?
  stripePriceId   String?
  status          String    @default("active")
  cancelAtPeriodEnd Boolean  @default(false)
  currentPeriodStart DateTime?
  currentPeriodEnd DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model RateLimit {
  key         String   @id
  hits        Int      @default(0)
  windowStart DateTime @map("window_start")

  @@map("rate_limits")
}

model YoutubeToken {
  id           String   @id @default(cuid())
  userId       String   @unique
  accessToken  String
  refreshToken String?
  expiresAt    DateTime
  channelId    String?
  channelName  String?
  channelThumb String?
  subscribers  String?
  totalViews   String?
  videoCount   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("youtube_tokens")
}

model VideoPreview {
  id        String   @id @default(cuid())
  userId    String
  title     String
  videoData Bytes
  mimeType  String   @default("video/webm")
  size      Int      @default(0)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("video_previews")
}

model YoutubeCache {
  key       String   @id
  data      Json
  expiresAt DateTime

  @@map("youtube_cache")
}

model ExtensionToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("extension_tokens")
}

model VideoSeoScore {
  id         String   @id @default(cuid())
  userId     String
  videoId    String
  score      Int
  checklist  Json
  analyzedAt DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@map("video_seo_scores")
}

model TrackedCompetitor {
  id          String   @id @default(cuid())
  userId      String
  channelId   String
  channelName String
  channelThumb String?
  subscribers  Int      @default(0)
  totalViews   BigInt   @default(0)
  videoCount   Int      @default(0)
  addedAt     DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshots   CompetitorSnapshot[]

  @@unique([userId, channelId])
  @@map("tracked_competitors")
}

model CompetitorSnapshot {
  id            String   @id @default(cuid())
  competitorId  String
  subscribers   Int
  totalViews    BigInt
  videoCount    Int
  recordedAt    DateTime @default(now())

  competitor    TrackedCompetitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@index([competitorId, recordedAt])
  @@map("competitor_snapshots")
}

model DailyIdea {
  id         String   @id @default(cuid())
  userId     String
  date       String
  ideas      Json
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("daily_ideas")
}

model ChannelSnapshot {
  id          String   @id @default(cuid())
  userId      String
  subscribers Int
  totalViews  BigInt
  videoCount  Int
  recordedAt  DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordedAt])
  @@map("channel_snapshots")
}

model BestTimeAnalysis {
  id         String   @id @default(cuid())
  userId     String   @unique
  heatmap    Json
  topSlots   Json
  videoCount Int
  aiTip      Json?
  analyzedAt DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("best_time_analyses")
}

model SocialPost {
  id          String    @id @default(cuid())
  platform    String
  content     String
  status      String    @default("pending")
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  errorMsg    String?
  bufferId    String?
  imageUrl    String?

  @@map("social_posts")
}

model DailyTip {
  date String @id  // formato YYYY-MM-DD
  es   String
  en   String

  @@map("daily_tips")
}

model UserFeedback {
  id          String    @id @default(cuid())
  userId      String    @unique
  token       String    @unique
  lang        String    @default("es")
  rating      Int?
  comment     String?
  submittedAt DateTime?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_feedbacks")
}

model SocialMessage {
  id           String    @id @default(cuid())
  platform     String
  fromUser     String
  content      String
  externalId   String?
  receivedAt   DateTime  @default(now())
  replied      Boolean   @default(false)
  replyContent String?
  repliedAt    DateTime?

  @@map("social_messages")
}
model NarrativeBible {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @default(now()) @updatedAt

  @@map("narrative_bible")
}

// ── YCML tables (local agent, raw SQL) ──────────────────────────────
// These tables are queried via raw SQL in local-agent/db.js.
// Column names MUST stay snake_case — do NOT remove @map directives.

model LinkedinProspect {
  id         Int      @id @default(autoincrement())
  profileUrl String   @unique @map("profile_url")
  name       String?
  headline   String?
  followers  Int?
  status     String?  @default("discovered")
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @map("updated_at")

  @@map("linkedin_prospects")
}

model LinkedinAction {
  id         Int      @id @default(autoincrement())
  type       String
  profileUrl String?  @map("profile_url")
  content    String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("linkedin_actions")
}

model TwitterAction {
  id        Int      @id @default(autoincrement())
  type      String
  tweetUrl  String?  @map("tweet_url")
  content   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("twitter_actions")
}

model InstagramAction {
  id        Int      @id @default(autoincrement())
  type      String
  postUrl   String?  @map("post_url")
  content   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("instagram_actions")
}

model FacebookAction {
  id        Int      @id @default(autoincrement())
  type      String
  postUrl   String?  @map("post_url")
  content   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("facebook_actions")
}

model CalendarEntry {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  date        String   // YYYY-MM-DD
  status      String   @default("idea") // idea | draft | scheduled | published
  color       String?  // hex color for visual grouping
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("calendar_entries")
}
