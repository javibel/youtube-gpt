// Committed atomically with the original entry; retained after entry deletion.
// Only original business lookup, never native runner recovery authority.
model CalendarCreationReceipt {
  id String @id @default(cuid())
  userId String
  key String
  input String
  entryId String?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  entry CalendarEntry? @relation(fields: [entryId], references: [id], onDelete: SetNull)
  @@unique([userId, key], map: "calendar_creation_receipts_userid_key_key")
  @@index([userId, createdAt], map: "calendar_creation_receipts_userid_createdat_idx")
  @@map("calendar_creation_receipts")
}

// Immutable original update/deletion result; never native recovery authority.
model CalendarMutationReceipt {
 id String @id @default(cuid())
 userId String
 key String
 method String
 entryId String
 input String
 output String
 createdAt DateTime @default(now())
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 @@unique([userId,key],map:"calendar_mutation_receipts_userid_key_key")
 @@index([userId,createdAt],map:"calendar_mutation_receipts_userid_createdat_idx")
 @@map("calendar_mutation_receipts")
}

