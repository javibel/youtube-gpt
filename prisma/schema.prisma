model PageView {
  id        String   @id @default(cuid())
  path      String
  referrer  String?
  userAgent String?  @map("user_agent")
  country   String?
  // 13/07: nullable a propósito — visitas anónimas siguen sin userId. Permite
  // reconstruir el journey por usuario (retención: ¿vuelven a la web aunque no
  // generen?). Sin FK a User para no borrar analytics al borrar la cuenta.
  userId    String?  @map("user_id")
  // Identificador anonimo de navegador (cookie propia ytv_sid, 30d). Sin datos
  // personales: solo sirve para contar visitantes unicos y saber quien sigue
  // navegando ahora mismo. Antes solo habia userId, asi que el trafico anonimo
  // era una masa indistinguible y no se podia medir nada por visitante.
  sessionId String?  @map("session_id")
  // Trafico propio: servidor de desarrollo, bots, headless (los smoke tests) y
  // cuentas internas. Se marca al escribir y se excluye por defecto al consultar.
  // Sin esto las cifras mezclaban las visitas de Javier con las de usuarios reales.
  internal  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([path, createdAt])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
  @@index([internal, createdAt])
  @@map("page_views")
}

// ── Agent-owned tables ──────────────────────────────────────────────────────
// These were created at runtime via raw SQL (CREATE TABLE IF NOT EXISTS) by the
// agent/cron code. They MUST be modeled here so `prisma db push --accept-data-loss`
// (run on every deploy) does not drop them and wipe their data each release.

model VerifyReminder {
  userId        String   @id @map("user_id")
  remindersSent Int      @default(0) @map("reminders_sent")
  lastSentAt    DateTime @default(now()) @map("last_sent_at")

  @@map("verify_reminders")
}

