generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_DIRECT")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  password      String?
  lang          String    @default("es")
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  signupReferrer   String?  // document.referrer at signup (e.g. google.com, reddit.com)
  signupLandingPage String? // first page the user landed on (e.g. /seo-score, /blog/...)
  // G4: baja de emails comerciales (LSSI) — los transaccionales no se ven afectados
  marketingOptOut Boolean @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  feedbackEmailSentAt    DateTime?
  onboardingEmailSentAt  DateTime?
  onboardingStep         Int       @default(0)
  referralCode           String?   @unique
  referredBy          String?
  referralRewardedAt     DateTime? // set once this user's paid conversion has credited their referrer (scripts/referral-rewards.js)

  // Programa de AFILIADOS (creadores curados a mano, comisión 30% recurrente 12m —
  // ver docs/programa-afiliados-especificacion-2026-07-09.md). Deliberadamente
  // SEPARADO del sistema de referidos peer-to-peer de arriba (referredBy/referralCode,
  // recompensa = 1 mes gratis): son dos programas distintos, con namespace distinto
  // (?aff= / cookie ytv_aff, no ?ref= / ytv_ref) para no colisionar con el existente.
  referredByCode         String?   // Affiliate.code, first-touch, se congela en el signup
  referredAt             DateTime?
  affiliate              Affiliate?

  accounts        Account[]
  sessions        Session[]
  backgroundImageAttempts BackgroundImageAttempt[]
  removalAttempts RemovalAttempt[]
  legacyThumbnailAttempts LegacyThumbnailAttempt[]
  textGenerationAttempts TextGenerationAttempt[]
  bulkGenerationRequests BulkGenerationRequest[]
  backgroundUploads BackgroundUpload[]
  thumbnailSaveReceipts ThumbnailSaveReceipt[]
  generations     Generation[]
  emailLogs       EmailLog[]
  subscription    Subscription?
  review          Review?
  youtubeToken    YoutubeToken?
  videoPreviews   VideoPreview[]
  videoSeoScores    VideoSeoScore[]
  bestTimeAnalysis  BestTimeAnalysis?
  bestTimeAnalysisAttempt BestTimeAnalysisAttempt?
  channelSnapshots  ChannelSnapshot[]
  dailyIdeas           DailyIdea[]
  trackedCompetitors   TrackedCompetitor[]
  competitorDeletionAttempts CompetitorDeletionAttempt[]
  competitorCreationAttempts CompetitorCreationAttempt[]
  extensionTokens      ExtensionToken[]
  extensionEvents      ExtensionEvent[]
  calendarEntries      CalendarEntry[]
  calendarCreationReceipts CalendarCreationReceipt[]
  calendarMutationReceipts CalendarMutationReceipt[]
  trendAlerts          TrendAlert[]
  feedback        UserFeedback?
  abTests         AbTest[]
  abTestCreationAttempts AbTestCreationAttempt[]
  abTestMutationAttempts AbTestMutationAttempt[]
  teamMemberships TeamMember[]
  teamCreations TeamCreationAttempt[]
  teamMemberMutations TeamMemberMutationAttempt[]
  teamInvitationRevocations TeamInvitationRevocationAttempt[]
  teamExits TeamExitAttempt[]
  teamRenames TeamRenameAttempt[]
  teamInvitations TeamInvitationAttempt[]
  teamJoins TeamJoinAttempt[]
  profileUpdates ProfileUpdateAttempt[]
  passwordChanges PasswordChangeAttempt[]
  checkoutAttempts CheckoutAttempt[]
  checkoutWebhookDenials CheckoutWebhookDenial[]
  billingWebhookDenials BillingWebhookDenial[]
  subscriptionCancellations SubscriptionCancellationAttempt[]
  subscriptionDowngrades SubscriptionDowngradeAttempt[]
  subscriptionSyncs SubscriptionSyncAttempt[]
  chatMessages      ChatMessage[]
  achievements      Achievement[]
  optimizeHistory   OptimizeHistory[]
  optimizeUpdateAttempts OptimizeUpdateAttempt[]

  @@map("users")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id        String   @id @default(cuid())
  sessionToken String  @unique
  userId    String
  expires   DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@map("email_verification_tokens")
}

model Generation {
  id          String    @id @default(cuid())
  userId      String
  template    String
  inputs      Json
  output      String
  tokensUsed  Int
  ipAddress   String?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([ipAddress, createdAt])
  @@map("generations")
}

// G4: registro de emails lifecycle enviados — idempotencia (nunca repetir un paso)
// y tope de 1 email/día/usuario. sequence='paywall' registra toques de paywall para C3.
model EmailLog {
  id       String   @id @default(cuid())
  userId   String
  sequence String
  step     String
  sentAt   DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sequence, step])
  @@index([userId, sentAt])
  @@map("email_logs")
}

model Review {
  id        String   @id @default(cuid())
  userId    String   @unique
  rating    Int
  text      String
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model Subscription {
  id              String    @id @default(cuid())
  userId          String    @unique
  stripeCustomerId String?
  stripePriceId   String?
  plan            String    @default("pro")
  status          String    @default("active")
  cancelAtPeriodEnd Boolean  @default(false)
  currentPeriodStart DateTime?
  currentPeriodEnd DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model RateLimit {
  key         String   @id
  hits        Int      @default(0)
  windowStart DateTime @map("window_start")

  @@map("rate_limits")
}

// Shared native admin second-factor replay denial, independent of session lifetime.
model TotpConsumption {
  key        String   @id
  counter    BigInt
  consumedAt DateTime @default(now()) @map("consumed_at")

  @@map("totp_consumptions")
}

model YoutubeToken {
  id           String   @id @default(cuid())
  userId       String   @unique
  accessToken  String
  refreshToken String?
  expiresAt    DateTime
  channelId    String?
  channelName  String?
  channelThumb String?
  subscribers  String?
  totalViews   String?
  videoCount   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("youtube_tokens")
}

model VideoPreview {
  id        String   @id @default(cuid())
  userId    String
  title     String
  videoData Bytes
  mimeType  String   @default("video/webm")
  size      Int      @default(0)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("video_previews")
}

model YoutubeCache {
  key       String   @id
  data      Json
  expiresAt DateTime

  @@map("youtube_cache")
}

model ExtensionToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("extension_tokens")
}

// Un registro por petición autenticada de la extensión (vía getExtensionUser).
// Señal de retención: permite contar "usó la extensión esta semana", cosa que
// hasta ahora era invisible — las rutas de la extensión no escribían nada.
model ExtensionEvent {
  id        String   @id @default(cuid())
  userId    String
  action    String   // ruta relativa, p.ej. "seo-quick", "seo-live", "ab-test"
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("extension_events")
}

// Rolling viewCount snapshot per video, used by the extension scorecard to compute RECENT
// views-per-hour velocity (delta since last snapshot) instead of the lifetime average.
// Write-light: refreshed at most once every ~2h per video.
model VideoVelocitySnapshot {
  videoId    String   @id
  viewCount  BigInt
  capturedAt DateTime @default(now())

  @@map("video_velocity_snapshots")
}

model VideoSeoScore {
  id          String   @id @default(cuid())
  userId      String
  videoId     String
  title       String?
  thumbnail   String?
  publishedAt String?
  views       Int?
  score       Int
  checklist   Json
  analyzedAt  DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@map("video_seo_scores")
}

model TrackedCompetitor {
  id          String   @id @default(cuid())
  userId      String
  channelId   String
  channelName String
  channelThumb String?
  subscribers  Int      @default(0)
  totalViews   BigInt   @default(0)
  videoCount   Int      @default(0)
  addedAt     DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshots   CompetitorSnapshot[]

  @@unique([userId, channelId])
  @@map("tracked_competitors")
}

model CompetitorDeletionAttempt {
  id String @id
  userId String
  competitorId String
  state String @default("pending")
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, competitorId])
  @@map("competitor_deletion_attempts")
}

model CompetitorCreationAttempt {
  id String @id
  userId String
  channelId String
  state String @default("pending")
  competitorId String?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, channelId, state])
  @@map("competitor_creation_attempts")
}

model CompetitorSnapshot {
  id            String   @id @default(cuid())
  competitorId  String
  subscribers   Int
  totalViews    BigInt
  videoCount    Int
  recordedAt    DateTime @default(now())

  competitor    TrackedCompetitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@index([competitorId, recordedAt])
  @@map("competitor_snapshots")
}

model DailyIdea {
  id         String   @id @default(cuid())
  userId     String
  date       String
  ideas      Json
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("daily_ideas")
}

model ChannelSnapshot {
  id          String   @id @default(cuid())
  userId      String
  subscribers Int
  totalViews  BigInt
  videoCount  Int
  recordedAt  DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordedAt])
  @@map("channel_snapshots")
}

model BestTimeAnalysis {
  id         String   @id @default(cuid())
  userId     String   @unique
  heatmap    Json
  topSlots   Json
  videoCount Int
  aiTip      Json?
  analyzedAt DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("best_time_analyses")
}

// Excludes another fresh statistical analysis; never an AI credit or recovery permission.
model BestTimeAnalysisAttempt {
  id        String @id
  userId    String @unique
  email     String
  channelId String
  referenceAt DateTime?
  state     String @default("pending")
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("best_time_analysis_attempts")
}

model Team {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  plan        String           @default("team") // team, agency
  maxMembers  Int              @default(5)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  members     TeamMember[]
  invitations TeamInvitation[]
  creationAttempt TeamCreationAttempt?

  @@map("teams")
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String
  role     String   @default("member") // owner, admin, member
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@unique([userId], map: "team_member_user_single")
  @@map("team_members")
}

// Stored rows deny fresh work; only the original live invocation may finish.
model TeamCreationAttempt {
  id String @id
  userId String
  email String
  key String
  name String
  state String @default("pending")
  teamId String? @unique
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@unique([userId, key])
  @@index([userId, state], map: "team_creation_lookup")
  @@map("team_creation_attempts")
}

// Retained denial survives member/team deletion; only the original live producer may finish.
model TeamMemberMutationAttempt {
  id String @id
  userId String
  email String
  key String
  operation String
  teamId String
  actorMemberId String
  actorRole String
  memberId String
  targetUserId String
  previousRole String
  role String?
  state String @default("pending")
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, key])
  @@index([teamId, state], map: "team_member_mutation_lookup")
  @@map("team_member_mutation_attempts")
}

// Denial survives invitation/team deletion; no stored row can continue its original producer.
model TeamInvitationRevocationAttempt {
  id String @id
  userId String
  email String
  key String
  operation String
  teamId String
  actorMemberId String
  actorRole String
  invitationId String
  targetEmail String
  previousRole String
  previousExpiresAt String
  state String @default("pending")
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, key])
  @@index([teamId, state], map: "team_invitation_revocation_lookup")
  @@map("team_invitation_revocation_attempts")
}

// Denial survives team/membership deletion; only the original producer may finish.
model TeamExitAttempt {
  id String @id
  userId String
  email String
  key String
  teamId String
  memberId String
  previousRole String
  operation String
  state String @default("pending")
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, key])
  @@index([teamId, state], map: "team_exit_lookup")
  @@map("team_exit_attempts")
}

model TeamRenameAttempt {
  id String @id
  userId String
  email String
  key String
  teamId String
  memberId String
  previousRole String
  previousName String
  name String
  state String @default("pending")
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, key])
  @@index([teamId, state], map: "team_rename_lookup")
  @@map("team_rename_attempts")
}

// Retained denial survives invitation/team deletion; no mail sender recovery.
model TeamInvitationAttempt {
  id String @id
  userId String
  email String
  key String
  teamId String
  memberId String
  previousRole String
  targetEmail String
  role String
  invitationId String
  expiresAt String
  state String @default("pending")
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, key])
  @@index([teamId, state], map: "team_invitation_lookup")
  @@map("team_invitation_attempts")
}

// No token or team/member FK: denial survives consumption and team deletion.
model TeamJoinAttempt {
  id String @id
  userId String
  email String
  key String
  teamId String
  teamName String
  invitationId String
  targetEmail String
  role String
  expiresAt String
  membershipId String
  state String @default("pending")
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, key])
  @@index([teamId, state], map: "team_join_lookup")
  @@map("team_join_attempts")
}

model TeamInvitation {
  id        String   @id @default(cuid())
  teamId    String
  email     String
  role      String   @default("member")
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, email])
  @@map("team_invitations")
}

model AbTest {
  id              String    @id @default(cuid())
  userId          String
  videoId         String
  thumbnail       String?
  originalTitle   String
  variantA        String
  variantB        String
  status          String    @default("variant_a") // variant_a, variant_b, completed, cancelled
  hoursPerVariant Int       @default(48)
  startedAt       DateTime  @default(now())
  switchedAt      DateTime?
  completedAt     DateTime?
  initialViews    Int       @default(0)
  switchViews     Int?
  endViews        Int?
  winner          String?
  aiInsight       Json?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  creationAttempt AbTestCreationAttempt?

  @@index([userId])
  @@map("ab_tests")
}

// A pending reservation only denies more fresh work. Its stored identity
// never grants execution, recovery, release or ownership after process loss.
model AbTestCreationAttempt {
  id        String   @id
  userId    String
  videoId   String
  state     String   @default("pending")
  testId    String?  @unique
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  test      AbTest?  @relation(fields: [testId], references: [id], onDelete: SetNull)

  @@index([userId, state])
  @@index([userId, videoId, state])
  @@map("ab_test_creation_attempts")
}

// Stored records only deny fresh work. Only the original live invocation may
// finish its reservation; no expiry, takeover or recovery from an identifier.
model AbTestMutationAttempt {
  id String @id
  userId String
  videoId String
  testId String
  action String
  state String @default("pending")
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, videoId, state])
  @@index([userId, testId, action, state])
  @@map("ab_test_mutation_attempts")
}

model SocialPost {
  id          String    @id @default(cuid())
  platform    String
  content     String
  status      String    @default("pending")
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  errorMsg    String?
  bufferId    String?
  imageUrl    String?

  @@map("social_posts")
}

model DailyTip {
  date String @id  // formato YYYY-MM-DD
  es   String
  en   String

  @@map("daily_tips")
}

model UserFeedback {
  id          String    @id @default(cuid())
  userId      String    @unique
  token       String    @unique
  lang        String    @default("es")
  rating      Int?
  comment     String?
  submittedAt DateTime?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_feedbacks")
}

model SocialMessage {
  id           String    @id @default(cuid())
  platform     String
  fromUser     String
  content      String
  externalId   String?
  receivedAt   DateTime  @default(now())
  replied      Boolean   @default(false)
  replyContent String?
  repliedAt    DateTime?

  @@map("social_messages")
}
model NarrativeBible {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @default(now()) @updatedAt

  @@map("narrative_bible")
}

// ── YCML tables (local agent, raw SQL) ──────────────────────────────
// These tables are queried via raw SQL in local-agent/db.js.
// Column names MUST stay snake_case — do NOT remove @map directives.

model LinkedinProspect {
  id         Int      @id @default(autoincrement())
  profileUrl String   @unique @map("profile_url")
  name       String?
  headline   String?
  followers  Int?
  status     String?  @default("discovered")
  accountId  String?  @map("account_id")
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @map("updated_at")

  @@map("linkedin_prospects")
}

model LinkedinAction {
  id         Int      @id @default(autoincrement())
  type       String
  profileUrl String?  @map("profile_url")
  content    String?
  accountId  String?  @map("account_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("linkedin_actions")
}

model TwitterAction {
  id        Int      @id @default(autoincrement())
  type      String
  tweetUrl  String?  @map("tweet_url")
  content   String?
  accountId String?  @map("account_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("twitter_actions")
}

model InstagramAction {
  id        Int      @id @default(autoincrement())
  type      String
  postUrl   String?  @map("post_url")
  content   String?
  accountId String?  @map("account_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("instagram_actions")
}

model FacebookAction {
  id        Int      @id @default(autoincrement())
  type      String
  postUrl   String?  @map("post_url")
  content   String?
  accountId String?  @map("account_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("facebook_actions")
}

model RedditAction {
  id        Int      @id @default(autoincrement())
  type      String
  postUrl   String?  @map("post_url")
  content   String?
  accountId String?  @map("account_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("reddit_actions")
}

model FollowupCheck {
  id               Int      @id @default(autoincrement())
  platform         String
  originalActionId Int?     @map("original_action_id")
  postUrl          String?  @map("post_url")
  replyAuthor      String?  @map("reply_author")
  replyContent     String?  @map("reply_content")
  ourResponse      String?  @map("our_response")
  responded        Boolean  @default(false)
  accountId        String?  @map("account_id")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("followup_checks")
}

model CalendarEntry {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  date        String   // YYYY-MM-DD
  status      String   @default("idea") // idea | draft | scheduled | published
  color       String?  // hex color for visual grouping
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  creationReceipts CalendarCreationReceipt[]

  @@index([userId, date])
  @@map("calendar_entries")
}

model TrendAlert {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String
  category    String   // e.g. "gaming", "tech", "education"
  relevance   Int      // 0-100
  trendData   Json?    // {videos: [{title, views, channelName}], keyword}
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

