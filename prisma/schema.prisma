// Programa de afiliados — ver docs/programa-afiliados-especificacion-2026-07-09.md
model Affiliate {
  id            String    @id @default(cuid())
  code          String    @unique // corto, elegible por el afiliado: "erika"
  name          String
  email         String
  userId        String?   @unique @map("user_id") // cuenta YTubViral vinculada (opcional hasta aprobar)
  commissionPct Int       @default(30) @map("commission_pct")
  monthsPaid    Int       @default(12) @map("months_paid")
  status        String    @default("pending") // pending | active | paused | terminated
  payoutMethod  String?   @map("payout_method") // "paypal:email" | "bank:IBAN" — texto libre, v1 manual
  channelInfo   String?   @map("channel_info") // lo que puso en el form de solicitud (canal/audiencia/cómo promociona)
  createdAt     DateTime  @default(now()) @map("created_at")

  user        User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  clicks      AffiliateClick[]
  commissions AffiliateCommission[]

  @@map("affiliates")
}

model AffiliateClick {
  id          String   @id @default(cuid())
  affiliateId String   @map("affiliate_id")
  createdAt   DateTime @default(now()) @map("created_at")
  referer     String?
  country     String?

  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId, createdAt])
  @@map("affiliate_clicks")
}

model AffiliateCommission {
  id                 String    @id @default(cuid())
  affiliateId        String    @map("affiliate_id")
  referredUserId     String    @map("referred_user_id")
  stripeInvoiceId    String    @unique @map("stripe_invoice_id") // idempotencia: 1 factura = 1 comisión
  invoiceAmountCents Int       @map("invoice_amount_cents")
  commissionCents    Int       @map("commission_cents")
  status             String    @default("pending") // pending | approved | paid | reversed
  createdAt          DateTime  @default(now()) @map("created_at")
  paidAt             DateTime? @map("paid_at")

  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId, status])
  @@map("affiliate_commissions")
}

// Violaciones de CSP agrupadas. Hasta el 26/08/2026 la politica enforced no tenia
// report-uri, asi que los bloqueos REALES no se registraban en ningun sitio — por
// eso el bloqueo de media-src estuvo dos meses roto en silencio. El endpoint
// /api/csp-report hace upsert aqui (unico por directiva+recurso) y el Guardian
// avisa de lo que sea nuevo. El unique evita que un bucle de reportes crezca sin fin.
model CspViolation {
  id         String   @id @default(cuid())
  directive  String
  blockedUri String
  documentUri String?
  reportOnly Boolean  @default(false)
  count      Int      @default(1)
  firstSeen  DateTime @default(now())
  lastSeen   DateTime @updatedAt
  notified   Boolean  @default(false)

  @@unique([directive, blockedUri, reportOnly])
  @@index([notified, lastSeen])
  @@map("csp_violations")
}

